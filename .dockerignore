# Version control
.git
.gitignore
.gitattributes

# Dependencies (installed inside the image)
/node_modules
/vendor

# Build output (rebuilt inside the image)
/public/build
/public/hot
/public/storage
/bootstrap/ssr

# Wayfinder-generated sources (regenerated by the Vite build)
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# Local env / secrets
.env
.env.backup
.env.production

# Laravel runtime
/storage/*.key
/storage/pail
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*

# Database backups (imported via MySQL init volume, not baked into the image)
database sql backup file/
hall-hstu-db-backup/

# Editor / tooling
.idea
.vscode
.fleet
.zed
.claude
.remember
.phpunit.cache
.phpunit.result.cache

# Reports / docs artifacts (not needed at runtime)
*.docx
HSTU_Hall_Manager_Report.md
generate_report_docx.py
*.png

# Docker artifacts
Dockerfile
.dockerignore
compose.yml
