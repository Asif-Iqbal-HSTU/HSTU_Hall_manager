# =============================================================================
# HSTU Hall Manager — Laravel 13 + Inertia (React 19 / TS) + Tailwind v4
#
# This app uses Laravel Wayfinder, whose Vite plugin shells out to
# `php artisan wayfinder:generate` during `npm run build`. That means the
# frontend build needs a bootable PHP app (extensions + vendor) available —
# so we build the frontend on top of the same PHP base image rather than in
# an isolated Node-only stage.
# =============================================================================

# =============================================================================
# Stage 1: Base PHP image with all runtime extensions (shared by build + prod)
# =============================================================================
FROM php:8.4.27-fpm-alpine AS base

# Install system dependencies and PHP extensions in a single layer
RUN apk add --no-cache \
        nginx \
        supervisor \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libzip-dev \
        zip \
        unzip \
        curl \
        oniguruma-dev \
        icu-dev \
        libxml2-dev \
        tzdata \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        xml \
        opcache \
    && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# =============================================================================
# Stage 2: Builder — install PHP + Node deps and compile frontend assets
# =============================================================================
FROM base AS builder

# Node.js toolchain (Alpine 3.22 ships Node 22, which satisfies Vite 8)
RUN apk add --no-cache nodejs npm git

# Install PHP dependencies first (Wayfinder lives in vendor/ and is needed by
# the Vite build). Scripts are skipped until the full source is present.
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --optimize-autoloader \
        --no-scripts

# Install Node dependencies (skip lifecycle scripts, e.g. puppeteer downloads)
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy the full application source
COPY . .

# A bootable .env is required so `php artisan wayfinder:generate` (invoked by
# the Vite build) can boot the framework. This is a throwaway build-time env;
# the real runtime env is generated by the entrypoint.
RUN cp .env.example .env \
    && mkdir -p database \
    && touch database/database.sqlite \
    && composer dump-autoload --optimize \
    && php artisan key:generate --force

# Build frontend assets (runs `php artisan wayfinder:generate` under the hood)
RUN npm run build

# =============================================================================
# Stage 3: Production image
# =============================================================================
FROM base AS production

LABEL maintainer="HSTU Hall Manager" \
      app.name="hstu-hall-manager" \
      app.version="1.0"

# Configure PHP for production
RUN { \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.interned_strings_buffer=8'; \
        echo 'opcache.max_accelerated_files=4000'; \
        echo 'opcache.revalidate_freq=0'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.fast_shutdown=1'; \
        echo 'opcache.enable_cli=1'; \
        echo 'opcache.save_comments=1'; \
    } > /usr/local/etc/php/conf.d/opcache-recommended.ini \
    && { \
        echo 'upload_max_filesize=64M'; \
        echo 'post_max_size=64M'; \
        echo 'memory_limit=256M'; \
        echo 'max_execution_time=600'; \
        echo 'max_input_time=600'; \
        echo 'expose_php=Off'; \
    } > /usr/local/etc/php/conf.d/custom.ini

# Configure Nginx and Supervisor
COPY docker/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/supervisord.conf /etc/supervisord.conf

WORKDIR /var/www/html

# Copy vendored PHP dependencies from the builder (already installed --no-dev)
COPY --from=builder /var/www/html/vendor ./vendor

# Copy the application source
COPY . .

# Re-run the optimized autoloader now the full source is present
RUN composer dump-autoload --optimize --no-scripts

# Copy compiled frontend assets from the builder
COPY --from=builder /var/www/html/public/build ./public/build

# Create required directories and set permissions
RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/testing \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 storage bootstrap/cache

# Create storage symlink
RUN php artisan storage:link || true

# Copy and set up entrypoint
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Health check for the container (Laravel exposes /up)
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/up || exit 1

EXPOSE 80

ENTRYPOINT ["entrypoint.sh"]
CMD ["supervisord", "-c", "/etc/supervisord.conf"]
